# Copy this file to .env.local and fill with your values.
# .env.local is git-ignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# OPCIÓN A — MySQL local (desarrollo)
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cj_app
MYSQL_PASSWORD=your-app-db-password
MYSQL_DATABASE=constructora_cj
MYSQL_SSL=false

# ---------------------------------------------------------------------------
# OPCIÓN B — TiDB Cloud (nube). Usa los datos del botón "Connect" del cluster.
# El puerto es 4000 (no 3306) y MYSQL_SSL debe ser true (TLS obligatorio).
# ---------------------------------------------------------------------------
# MYSQL_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=2abc3Def4Gh.root
# MYSQL_PASSWORD=tu-password-de-tidb
# MYSQL_DATABASE=test
# MYSQL_SSL=true

# Secret used to sign the session JWT cookie (min 16 chars; use a long random value).
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
